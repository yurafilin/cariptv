<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Same CarPlay key as device builds, so the Simulator behaves like production: a video app is hidden
	on CarPlay displays that do not support video (the Xcode 26.3 / iOS 26.3 Simulator display does not).
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.carplay-video</key>
	<true/>
</dict>
</plist>
